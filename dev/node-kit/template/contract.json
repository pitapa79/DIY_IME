    {
      "id": "choice-is-not-text",
      "input": {"status":"data","packet":{"version":1,"root":{"type":"choice","options":[]}}},
      "expected": {"status":"error","code":"invalid-root"}
    },
    {
      "id": "invalid-version",
      "input": {"status":"data","packet":{"version":2,"root":{"type":"text","text":"a"}}},
      "expected": {"status":"error","code":"invalid-packet"}
