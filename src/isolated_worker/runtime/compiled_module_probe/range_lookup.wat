(module
  (memory (export "memory") 1)
  (func (export "diyime_api_version") (result i32) i32.const 1)
  (func (export "diyime_alloc") (param $size i32) (result i32)
    (if (result i32) (i32.le_u (local.get $size) (i32.const 4104))
      (then (i32.const 64)) (else (i32.const 0))))
  (func (export "diyime_release_reply"))
  (func (export "diyime_call") (param $input i32) (param $length i32) (result i64)
    (local $key i64) (local $reading i64)
    (local $base i32) (local $low i32) (local $high i32)
    (local $mid i32) (local $entry i32)
    (i32.store8 (i32.const 16) (i32.const 0))
    (i64.store (i32.const 17) (i64.const 0))
    (local.set $key (i64.load (local.get $input)))
    (local.set $base (i32.add (local.get $input) (i32.const 8)))
    (local.set $high (i32.shr_u (i32.sub (local.get $length) (i32.const 8)) (i32.const 4)))
    (block $done
      (if (i64.lt_u (local.get $key) (i64.load (local.get $base)))
        (then (i32.store8 (i32.const 16) (i32.const 1)) (br $done)))
      (local.set $entry (i32.add (local.get $base)
        (i32.shl (i32.sub (local.get $high) (i32.const 1)) (i32.const 4))))
      (if (i64.gt_u (local.get $key) (i64.load (local.get $entry)))
        (then (i32.store8 (i32.const 16) (i32.const 2)) (br $done)))
      (loop $search
        (br_if $done (i32.ge_u (local.get $low) (local.get $high)))
        (local.set $mid (i32.shr_u (i32.add (local.get $low) (local.get $high)) (i32.const 1)))
        (local.set $entry (i32.add (local.get $base) (i32.shl (local.get $mid) (i32.const 4))))
        (local.set $reading (i64.load (local.get $entry)))
        (if (i64.eq (local.get $reading) (local.get $key))
          (then
            (i32.store8 (i32.const 16) (i32.const 3))
            (i64.store (i32.const 17) (i64.load offset=8 (local.get $entry)))
            (br $done)))
        (if (i64.lt_u (local.get $reading) (local.get $key))
          (then (local.set $low (i32.add (local.get $mid) (i32.const 1))))
          (else (local.set $high (local.get $mid))))
        (br $search)))
    ;; ABI descriptor: 9-byte developer-only result at offset 16.
    (i64.const 38654705680)))
